<!-- OrdersView.xaml -->

<UserControl x:Class="RestaurantApp.Views.Customer.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <UserControl.Resources>

        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="10"/>

            <Setter Property="Background"
                    Value="Transparent"/>

        </Style>

        <Style TargetType="Thumb">

            <Setter Property="Background"
                    Value="#C2C2C2"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Thumb">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="ModernCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#333333"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="Border"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    BorderBrush="#BBBBBB"
                                    BorderThickness="1"
                                    Background="White"
                                    VerticalAlignment="Center">

                                <TextBlock x:Name="CheckIcon"
                                           Text="✓"
                                           FontSize="12"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                            </Border>

                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5F5F5F"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                                <Setter TargetName="CheckIcon"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="TopBarButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="MinWidth"
                    Value="90"/>

            <Setter Property="Padding"
                    Value="18,8"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#5F5F5F"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4F4F4F"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#3F3F3F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="#F5F5F5">

        <Border Height="70"
                VerticalAlignment="Top"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="📦"
                               FontSize="24"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="My Orders"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <CheckBox Grid.Column="1"
                          Content="Show only active"
                          VerticalAlignment="Center"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          IsChecked="{Binding ShowOnlyActive}"/>

            </Grid>

        </Border>

        <ScrollViewer Margin="20,95,14,20"
                      Padding="0,0,6,0"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Orders}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Margin="0,0,0,16"
                                Padding="18"
                                Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="12">

                            <StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="{Binding OrderCode}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#333333"/>

                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="13"
                                                   Foreground="#777777">

                                            <Run Text="{Binding CreatedAt,
                                                StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>

                                        </TextBlock>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Foreground"
                                                        Value="#2E7D32"/>

                                                <Setter Property="Text"
                                                        Value="{Binding Status}"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Cancelled">

                                                        <Setter Property="Foreground"
                                                                Value="#666666"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Delivered">

                                                        <Setter Property="Foreground"
                                                                Value="#1565C0"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </Grid>

                                <!-- PRODUCTS -->

                                <StackPanel Margin="0,18,0,0">

                                    <TextBlock Text="Products"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#444444"/>

                                    <ItemsControl Margin="0,10,0,0"
                                                  ItemsSource="{Binding OrderItems}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <StackPanel Margin="0,0,0,14">

                                                    <!-- DISH -->

                                                    <StackPanel Orientation="Horizontal">

                                                        <StackPanel.Style>

                                                            <Style TargetType="StackPanel">

                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding Dish}"
                                                                                 Value="{x:Null}">

                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </StackPanel.Style>

                                                        <TextBlock Text="{Binding Dish.Name}"
                                                                   Foreground="#555555"/>

                                                        <TextBlock Margin="10,0,0,0"
                                                                   Foreground="#666666"
                                                                   FontWeight="SemiBold">

                                                            <Run Text="{Binding Price,
                                                                    TargetNullValue=0,
                                                                StringFormat={}{0:F2}}"/>

                                                            <Run Text=" RON"/>

                                                        </TextBlock>

                                                        <TextBlock Margin="10,0,0,0"
                                                                   Foreground="#777777"
                                                                   FontWeight="SemiBold">

                                                            <Run Text="x "/>

                                                            <Run Text="{Binding Quantity,
                                                                            TargetNullValue=0}"/>

                                                            <Run Text=" buc"/>

                                                        </TextBlock>

                                                    </StackPanel>

                                                    <!-- MENU -->

                                                    <StackPanel>

                                                        <StackPanel.Style>

                                                            <Style TargetType="StackPanel">

                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding Menu}"
                                                                                 Value="{x:Null}">

                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </StackPanel.Style>

                                                        <TextBlock Text="{Binding Menu.Name}"
                                                                   FontWeight="Bold"
                                                                   FontSize="15"
                                                                   Foreground="#333333"
                                                                   Margin="0,0,0,8"/>

                                                        <ItemsControl ItemsSource="{Binding Menu.MenuDishes}">

                                                            <ItemsControl.ItemTemplate>

                                                                <DataTemplate>

                                                                    <Grid Margin="12,0,0,6">

                                                                        <Grid.ColumnDefinitions>

                                                                            <ColumnDefinition Width="*"/>

                                                                            <ColumnDefinition Width="Auto"/>

                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Foreground="#555555">

                                                                            <Run Text="• "/>

                                                                            <Run Text="{Binding Dish.Name}"/>

                                                                        </TextBlock>

                                                                        <TextBlock Grid.Column="1"
                                                                                   Foreground="#666666"
                                                                                   FontWeight="SemiBold">

                                                                            <Run Text="{Binding Dish.Price,
                                                                                StringFormat={}{0:F2}}"/>

                                                                            <Run Text=" RON"/>

                                                                        </TextBlock>

                                                                    </Grid>

                                                                </DataTemplate>

                                                            </ItemsControl.ItemTemplate>

                                                        </ItemsControl>

                                                        <Grid Margin="12,6,0,0">

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="Discount"
                                                                       Foreground="#3A8F3A"
                                                                       FontWeight="SemiBold"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Foreground="#3A8F3A"
                                                                       FontWeight="Bold">

                                                                <Run Text="-"/>

                                                                <Run Text="{Binding Menu.DiscountPercent}"/>

                                                                <Run Text="%"/>

                                                            </TextBlock>

                                                        </Grid>

                                                        <Grid Margin="12,6,0,0">

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="Menu Price"
                                                                       Foreground="#333333"
                                                                       FontWeight="Bold"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Foreground="#333333"
                                                                       FontWeight="Bold">

                                                                <Run Text="{Binding Price,
                                                                    StringFormat={}{0:F2}}"/>

                                                                <Run Text=" RON"/>

                                                                <Run Text=" x "/>

                                                                <Run Text="{Binding Quantity}"/>

                                                            </TextBlock>

                                                        </Grid>

                                                    </StackPanel>

                                                </StackPanel>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                                <!-- PRICE DETAILS -->

                                <StackPanel Margin="0,18,0,0">

                                    <Grid Margin="0,0,0,4">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Total Price:"
                                                   Foreground="#555555"/>

                                        <TextBlock Grid.Column="1"
                                                   Foreground="#555555"
                                                   FontWeight="SemiBold">

                                            <Run Text="{Binding FoodCost,
                                                StringFormat={}{0:F2}}"/>

                                            <Run Text=" RON"/>

                                        </TextBlock>

                                    </Grid>

                                    <Grid Margin="0,0,0,4">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Delivery:"
                                                   Foreground="#555555"/>

                                        <TextBlock Grid.Column="1"
                                                   Foreground="#555555"
                                                   FontWeight="SemiBold">

                                            <Run Text="{Binding DeliveryFee,
                                                StringFormat={}{0:F2}}"/>

                                            <Run Text=" RON"/>

                                        </TextBlock>

                                    </Grid>

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Discounts:"
                                                   Foreground="#3A8F3A"/>

                                        <TextBlock Grid.Column="1"
                                                   Foreground="#3A8F3A"
                                                   FontWeight="SemiBold">

                                            <Run Text="-"/>

                                            <Run Text="{Binding DiscountAmount,
                                                StringFormat={}{0:F2}}"/>

                                            <Run Text=" RON"/>

                                        </TextBlock>

                                    </Grid>

                                </StackPanel>

                                <Border Margin="0,16,0,14"
                                        Height="1"
                                        Background="#E5E5E5"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Final Total Price:"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#333333"/>

                                    <TextBlock Grid.Column="1"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#333333">

                                        <Run Text="{Binding TotalCost,
                                            StringFormat={}{0:F2}}"/>

                                        <Run Text=" RON"/>

                                    </TextBlock>

                                </Grid>

                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding EstimatedDeliveryTime,
                                            StringFormat='Estimated delivery: {0:HH:mm}'}"
                                           Foreground="#666666"/>

                                <Button Width="140"
                                        Margin="0,18,0,0"
                                        HorizontalAlignment="Left"
                                        Content="Cancel Order"
                                        Command="{Binding DataContext.CancelOrderCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">

                                    <Button.Style>

                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource TopBarButtonStyle}">

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="Cancelled">

                                                    <Setter Property="IsEnabled"
                                                            Value="False"/>

                                                    <Setter Property="Opacity"
                                                            Value="0.55"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="Delivered">

                                                    <Setter Property="IsEnabled"
                                                            Value="False"/>

                                                    <Setter Property="Opacity"
                                                            Value="0.55"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Button.Style>

                                </Button>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>