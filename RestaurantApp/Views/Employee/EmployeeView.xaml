<UserControl x:Class="RestaurantApp.Views.Employee.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ViewModels"
             mc:Ignorable="d"
             Background="#F5F5F5">

    <UserControl.Resources>
        
        <!-- ScrollBar -->

        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="10"/>

            <Setter Property="Background"
                    Value="Transparent"/>

        </Style>

        <Style TargetType="Thumb">

            <Setter Property="Background"
                    Value="#C2C2C2"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Thumb">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Modern Button -->

        <Style x:Key="ModernButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#5F5F5F"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4D4D4D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#3F3F3F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Danger Button -->

        <Style x:Key="DangerButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#A94444"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#913B3B"/>

                            </Trigger>

                            <!-- Pressed -->

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#7A3232"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- TextBox -->

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="BorderBrush"
                    Value="#BBBBBB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="12,5"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="220"/>

        </Grid.ColumnDefinitions>

        <!-- CONTENT -->

        <Grid Margin="0,0,20,0">

            <!-- Categories -->

            <StackPanel Visibility="{Binding IsCategoriesVisible,
                         Converter={StaticResource BooleanToVisibilityConverter}}">

                <Border Background="White"
                        CornerRadius="14"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="20">

                    <StackPanel>

                        <!-- Title -->

                        <TextBlock Text="Categories"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>

                        <TextBlock Margin="0,6,0,0"
                                   Text="Add and manage restaurant categories."
                                   Foreground="#888888"/>

                        <!-- Add -->

                        <Grid Margin="0,24,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="120"/>

                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding NewCategoryName}"/>

                            <Button Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Content="Add"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding AddCategoryCommand}"/>

                        </Grid>

                        <!-- Scroll List -->

                        <ScrollViewer Margin="0,24,0,0"
                                      Height="430"
                                      Padding="0,0,6,0"
                                      VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding Categories}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Margin="0,0,0,12"
                                                Padding="16"
                                                Background="#FAFAFA"
                                                BorderBrush="#E5E5E5"
                                                BorderThickness="1"
                                                CornerRadius="10">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="100"/>

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#333333"/>

                                                <Button Grid.Column="1"
                                                        Content="Delete"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding DataContext.DeleteCategoryCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </StackPanel>

                </Border>

            </StackPanel>

            <!-- Allergens -->

            <StackPanel Visibility="{Binding IsAllergensVisible,
                         Converter={StaticResource BooleanToVisibilityConverter}}">

                <Border Background="White"
                        CornerRadius="14"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Allergens"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>

                        <TextBlock Margin="0,6,0,0"
                                   Text="Manage allergens used by dishes."
                                   Foreground="#888888"/>

                        <!-- Add -->

                        <Grid Margin="0,24,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="120"/>

                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding NewAllergenName}"/>

                            <Button Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Content="Add"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Command="{Binding AddAllergenCommand}"/>

                        </Grid>

                        <!-- Scroll -->

                        <ScrollViewer Margin="0,24,0,0"
                                      Height="430"
                                      Padding="0,0,6,0"
                                      VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding Allergens}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Margin="0,0,0,12"
                                                Padding="16"
                                                Background="#FAFAFA"
                                                BorderBrush="#E5E5E5"
                                                BorderThickness="1"
                                                CornerRadius="10">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="100"/>

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#333333"/>

                                                <Button Grid.Column="1"
                                                        Content="Delete"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding DataContext.DeleteAllergenCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </StackPanel>

                </Border>

            </StackPanel>

            <!-- Low Stock -->

            <StackPanel Visibility="{Binding IsLowStockVisible,
                         Converter={StaticResource BooleanToVisibilityConverter}}">

                <Border Background="White"
                        CornerRadius="14"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Low Stock"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>

                        <TextBlock Margin="0,6,0,0"
                                   Text="Products close to depletion."
                                   Foreground="#888888"/>

                        <!-- Scroll -->

                        <ScrollViewer Margin="0,24,0,0"
                                      Height="500"
                                      Padding="0,0,6,0"
                                      VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding LowStockDishes}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Margin="0,0,0,12"
                                                Padding="16"
                                                Background="#FAFAFA"
                                                BorderBrush="#E5E5E5"
                                                BorderThickness="1"
                                                CornerRadius="10">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#333333"/>

                                                <TextBlock Grid.Column="1"
                                                           FontWeight="Bold"
                                                           Foreground="#B45309">

                                                    <Run Text="{Binding TotalQuantity}"/>

                                                    <Run Text=" left"/>

                                                </TextBlock>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

        <!-- SIDEBAR -->

        <Border Grid.Column="1"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">

            <StackPanel>

                <TextBlock Text="Management"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#333333"/>

                <!-- Categories -->

                <Border Margin="0,24,0,0"
                        Padding="14"
                        Background="#F8F8F8"
                        BorderBrush="#E5E5E5"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand">

                    <Border.InputBindings>

                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding ShowCategoriesCommand}"/>

                    </Border.InputBindings>

                    <StackPanel>

                        <TextBlock Text="Categories"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>

                        <TextBlock Margin="0,4,0,0"
                                   Text="Add and manage categories."
                                   FontSize="12"
                                   Foreground="#888888"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- Allergens -->

                <Border Margin="0,14,0,0"
                        Padding="14"
                        Background="#F8F8F8"
                        BorderBrush="#E5E5E5"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand">

                    <Border.InputBindings>

                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding ShowAllergensCommand}"/>

                    </Border.InputBindings>

                    <StackPanel>

                        <TextBlock Text="Allergens"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>

                        <TextBlock Margin="0,4,0,0"
                                   Text="Manage dish allergens."
                                   FontSize="12"
                                   Foreground="#888888"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- Low Stock -->

                <Border Margin="0,14,0,0"
                        Padding="14"
                        Background="#F8F8F8"
                        BorderBrush="#E5E5E5"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand">

                    <Border.InputBindings>

                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding ShowLowStockCommand}"/>

                    </Border.InputBindings>

                    <StackPanel>

                        <TextBlock Text="Low Stock"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>

                        <TextBlock Margin="0,4,0,0"
                                   Text="Monitor products close to depletion."
                                   FontSize="12"
                                   Foreground="#888888"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>