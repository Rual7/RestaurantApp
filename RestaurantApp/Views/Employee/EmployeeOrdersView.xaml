<!-- EmployeeOrdersView.xaml -->

<UserControl x:Class="RestaurantApp.Views.Employee.EmployeeOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- ScrollBar -->
        <!-- ===================================================== -->

        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="10"/>

            <Setter Property="Background"
                    Value="Transparent"/>

        </Style>

        <Style TargetType="Thumb">

            <Setter Property="Background"
                    Value="#C2C2C2"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Thumb">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ===================================================== -->
        <!-- CheckBox -->
        <!-- ===================================================== -->

        <Style x:Key="ModernCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#333333"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="Border"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    BorderBrush="#BBBBBB"
                                    BorderThickness="1"
                                    Background="White"
                                    VerticalAlignment="Center">

                                <TextBlock x:Name="CheckIcon"
                                           Text="✓"
                                           FontSize="12"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                            </Border>

                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5F5F5F"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                                <Setter TargetName="CheckIcon"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ===================================================== -->
        <!-- Button -->
        <!-- ===================================================== -->

        <Style x:Key="TopBarButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="MinWidth"
                    Value="110"/>

            <Setter Property="Padding"
                    Value="18,8"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#5F5F5F"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4F4F4F"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#3F3F3F"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ===================================================== -->
        <!-- ComboBox -->
        <!-- ===================================================== -->

        <Style x:Key="ModernComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="10,4"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#333333"/>

            <Setter Property="BorderBrush"
                    Value="#BBBBBB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="40"/>

                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="▼"
                                               FontSize="10"
                                               Foreground="#666666"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}"/>

                            <Popup Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">

                                <Border Margin="0,-2,0,0"
                                        Width="{Binding ActualWidth,
                                                        RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="White"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="0,0,8,8">

                                    <ScrollViewer MaxHeight="220">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="#F5F5F5">

        <!-- TOP -->

        <Border Height="82"
                VerticalAlignment="Top"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <StackPanel VerticalAlignment="Center">

                    <!-- TITLE -->

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="📦"
                                   FontSize="24"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="Orders Management"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>

                    </StackPanel>

                    <!-- FILTER -->

                    <CheckBox Margin="34,6,0,0"
                              Content="Show only active"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              IsChecked="{Binding ShowOnlyActive}"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ORDERS -->

        <ScrollViewer Margin="20,105,14,20"
                      Padding="0,0,6,0"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Orders}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Margin="0,0,0,16"
                                Padding="18"
                                Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="12">

                            <StackPanel>

                                <!-- HEADER -->

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT -->

                                    <StackPanel>

                                        <TextBlock Text="{Binding OrderCode}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#333333"/>

                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="#777777">

                                            <Run Text="{Binding CreatedAt,
                                                StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>

                                        </TextBlock>

                                    </StackPanel>

                                    <!-- STATUS -->

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Foreground"
                                                        Value="#2E7D32"/>

                                                <Setter Property="Text"
                                                        Value="{Binding Status}"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Cancelled">

                                                        <Setter Property="Foreground"
                                                                Value="#666666"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Delivered">

                                                        <Setter Property="Foreground"
                                                                Value="#1565C0"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </Grid>

                                <!-- CLIENT -->

                                <StackPanel Margin="0,18,0,0">

                                    <TextBlock Text="Client"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#444444"/>

                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#555555">

                                        <Run Text="{Binding User.FirstName}"/>

                                        <Run Text=" "/>

                                        <Run Text="{Binding User.LastName}"/>

                                    </TextBlock>

                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding User.PhoneNumber}"
                                               Foreground="#666666"/>

                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding User.Address}"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <!-- PRODUCTS -->

                                <StackPanel Margin="0,18,0,0">

                                    <TextBlock Text="Products"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#444444"/>

                                    <ItemsControl Margin="0,10,0,0"
                                                  ItemsSource="{Binding OrderItems}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <StackPanel Margin="0,0,0,8"
                                                            Orientation="Horizontal">

                                                    <TextBlock Text="{Binding Dish.Name}"
                                                               Foreground="#555555"/>

                                                    <TextBlock Margin="10,0,0,0"
                                                               FontWeight="SemiBold"
                                                               Foreground="#666666">

                                                        <Run Text="{Binding Price,
                                                            StringFormat={}{0:F2}}"/>

                                                        <Run Text=" RON"/>

                                                    </TextBlock>

                                                    <TextBlock Margin="10,0,0,0"
                                                               FontWeight="SemiBold"
                                                               Foreground="#777777">

                                                        <Run Text="x "/>

                                                        <Run Text="{Binding Quantity}"/>

                                                        <Run Text=" buc"/>

                                                    </TextBlock>

                                                </StackPanel>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                                <!-- TOTALS -->

                                <StackPanel Margin="0,18,0,0">

                                    <Grid Margin="0,0,0,4">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Food Cost:"
                                                   Foreground="#555555"/>

                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold">

                                            <Run Text="{Binding FoodCost,
                                                StringFormat={}{0:F2}}"/>

                                            <Run Text=" RON"/>

                                        </TextBlock>

                                    </Grid>

                                    <Grid Margin="0,0,0,4">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Delivery:"
                                                   Foreground="#555555"/>

                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold">

                                            <Run Text="{Binding DeliveryFee,
                                                StringFormat={}{0:F2}}"/>

                                            <Run Text=" RON"/>

                                        </TextBlock>

                                    </Grid>

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Discount:"
                                                   Foreground="#3A8F3A"/>

                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   Foreground="#3A8F3A">

                                            <Run Text="-"/>

                                            <Run Text="{Binding DiscountAmount,
                                                StringFormat={}{0:F2}}"/>

                                            <Run Text=" RON"/>

                                        </TextBlock>

                                    </Grid>

                                </StackPanel>

                                <!-- SEPARATOR -->

                                <Border Margin="0,16,0,14"
                                        Height="1"
                                        Background="#E5E5E5"/>

                                <!-- FINAL -->

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Final Total:"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#333333"/>

                                    <TextBlock Grid.Column="1"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#333333">

                                        <Run Text="{Binding TotalCost,
                                            StringFormat={}{0:F2}}"/>

                                        <Run Text=" RON"/>

                                    </TextBlock>

                                </Grid>

                                <!-- DELIVERY -->

                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding EstimatedDeliveryTime,
                                            StringFormat='Estimated delivery: {0:HH:mm}'}"
                                           Foreground="#666666"/>

                                <!-- STATUS MANAGEMENT -->

                                <Border Margin="0,18,0,0"
                                        Padding="14"
                                        Background="#FAFAFA"
                                        BorderBrush="#E5E5E5"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="130"/>

                                        </Grid.ColumnDefinitions>

                                        <!-- LABEL -->

                                        <StackPanel VerticalAlignment="Center">

                                            <TextBlock Text="Update Status"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"/>

                                            <TextBlock Margin="0,3,0,0"
                                                       Text="Modify current order status"
                                                       FontSize="12"
                                                       Foreground="#888888"/>

                                        </StackPanel>

                                        <!-- CONTROLS -->

                                        <StackPanel Grid.Column="1">

                                            <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                                      ItemsSource="{Binding DataContext.Statuses,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Status}"
                                                      IsEnabled="{Binding CanEditStatus}"/>

                                            <Button Margin="0,10,0,0"
                                                    Content="Save"
                                                    Style="{StaticResource TopBarButtonStyle}"
                                                    IsEnabled="{Binding CanEditStatus}"
                                                    Command="{Binding DataContext.UpdateStatusCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>