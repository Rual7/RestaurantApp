<Window x:Class="RestaurantApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ViewModels"
        xmlns:views="clr-namespace:RestaurantApp.Views.Customer"
        mc:Ignorable="d"
        Title="RestaurantApp"
        Height="760"
        Width="940"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.DataContext>

        <viewModels:MainWindowViewModel/>

    </Window.DataContext>

    <Window.Resources>

        <!-- Top Bar Button Style -->

        <Style x:Key="TopBarButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
            Value="40"/>

            <Setter Property="MinWidth"
            Value="90"/>

            <Setter Property="Padding"
            Value="18,8"/>

            <Setter Property="FontSize"
            Value="14"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="Background"
            Value="#5F5F5F"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="VerticalAlignment"
            Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="Border"
                                Property="Background"
                                Value="#4F4F4F"/>

                            </Trigger>

                            <!-- Pressed -->

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter TargetName="Border"
                                Property="Background"
                                Value="#3F3F3F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- Top Bar -->

        <Border Height="70"
                VerticalAlignment="Top"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- Left -->

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="🍽️"
                               FontSize="26"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="RestaurantApp"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <!-- Right -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Welcome Section -->

                    <Grid VerticalAlignment="Center">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <!-- Welcome -->

                        <TextBlock Text="{Binding WelcomeText}"
                                   FontSize="15"
                                   Foreground="#555555"
                                   VerticalAlignment="Center"/>

                        <!-- My Orders -->

                        <TextBlock Grid.Row="1"
                                   Text="my orders"
                                   Margin="0,2,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#555555"
                                   Cursor="Hand"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IsClient,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                            <TextBlock.InputBindings>

                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding OpenOrdersCommand}"/>

                            </TextBlock.InputBindings>

                        </TextBlock>

                    </Grid>

                    <!-- Login -->

                    <Button Content="Login"
                            Margin="18,0,0,0"
                            Style="{StaticResource TopBarButtonStyle}"
                            Visibility="{Binding GuestButtonsVisibility}"
                            Command="{Binding OpenLoginCommand}"/>

                    <!-- Register -->

                    <Button Content="Register"
                            Margin="10,0,0,0"
                            Style="{StaticResource TopBarButtonStyle}"
                            Visibility="{Binding GuestButtonsVisibility}"
                            Command="{Binding OpenRegisterCommand}"/>

                    <!-- Logout -->

                    <Button Content="Logout"
                            Margin="18,0,0,0"
                            Style="{StaticResource TopBarButtonStyle}"
                            Visibility="{Binding LogoutButtonVisibility}"
                            Command="{Binding LogoutCommand}"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Content -->

        <Grid Margin="20,95,20,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="3*"/>

                <ColumnDefinition Width="16"/>

                <!-- Cart Column -->

                <ColumnDefinition Width="{Binding CartColumnWidth}"/>

            </Grid.ColumnDefinitions>

            <!-- Menu -->

            <views:MenuView Grid.Column="0"/>

            <!-- Cart -->

            <views:CartView Grid.Column="2"/>

        </Grid>

    </Grid>

</Window>