<Window x:Class="RestaurantApp.Views.Shared.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="380"
        Height="200"
        ShowInTaskbar="False">

    <Grid>

        <Border Width="320"
                Padding="24"
                CornerRadius="14"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.25"/>

            </Border.Effect>

            <StackPanel>

                <!-- Title -->

                <TextBlock x:Name="TitleText"
                           Text="Success"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- Message -->

                <TextBlock x:Name="MessageText"
                           Text="Message"
                           FontSize="14"
                           Foreground="#555555"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,26"/>

                <!-- Button -->

                <Button Content="OK"
                        Width="95"
                        Height="38"
                        HorizontalAlignment="Center"
                        Click="OkButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="Border"
                                    Background="#5F5F5F"
                                    CornerRadius="8">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="Border"
                                            Property="Background"
                                            Value="#4D4D4D"/>

                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="True">

                                    <Setter TargetName="Border"
                                            Property="Background"
                                            Value="#3F3F3F"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                    <Button.Foreground>
                        White
                    </Button.Foreground>

                    <Button.FontWeight>
                        SemiBold
                    </Button.FontWeight>

                    <Button.BorderThickness>
                        0
                    </Button.BorderThickness>

                    <Button.Cursor>
                        Hand
                    </Button.Cursor>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>