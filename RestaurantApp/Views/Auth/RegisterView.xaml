<Window x:Class="RestaurantApp.Views.Auth.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Register"
        Height="780"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Window.Resources>

        <!-- TextBox Style -->

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="BorderBrush"
                    Value="#BBBBBB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="10,4"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                                <Setter TargetName="Border"
                                        Property="BorderThickness"
                                        Value="1.5"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- PasswordBox Style -->

        <Style x:Key="ModernPasswordBoxStyle"
               TargetType="PasswordBox">

            <Setter Property="BorderBrush"
                    Value="#BBBBBB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="10,4"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="PasswordBox">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                                <Setter TargetName="Border"
                                        Property="BorderThickness"
                                        Value="1.5"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#5F5F5F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Button Style -->

        <Style x:Key="RegisterButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#5F5F5F"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4D4D4D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#3F3F3F"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <Border Padding="22"
                CornerRadius="14"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Create Account"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,0,0,24"
                           HorizontalAlignment="Center"/>

                <!-- First Name -->

                <TextBlock Text="👤 First Name"
                           FontWeight="SemiBold"/>

                <TextBox Margin="0,5,0,2"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Enter your first name"/>

                <TextBlock Text="{Binding FirstNameError}"
                           Foreground="Red"
                           FontSize="10"
                           Margin="3,0,0,8"/>

                <!-- Last Name -->

                <TextBlock Text="👤 Last Name"
                           FontWeight="SemiBold"/>

                <TextBox Margin="0,5,0,2"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Enter your last name"/>

                <TextBlock Text="{Binding LastNameError}"
                           Foreground="Red"
                           FontSize="10"
                           Margin="3,0,0,8"/>

                <!-- Email -->

                <TextBlock Text="✉ Email"
                           FontWeight="SemiBold"/>

                <TextBox Margin="0,5,0,2"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Example: name@example.com"/>

                <TextBlock Text="{Binding EmailError}"
                           Foreground="Red"
                           FontSize="10"
                           Margin="3,0,0,8"/>

                <!-- Phone -->

                <TextBlock Text="📞 Phone Number"
                           FontWeight="SemiBold"/>

                <TextBox Margin="0,5,0,2"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="15"
                         ToolTip="Enter your phone number"/>

                <TextBlock Text="{Binding PhoneNumberError}"
                           Foreground="Red"
                           FontSize="10"
                           Margin="3,0,0,8"/>

                <!-- Address -->

                <TextBlock Text="📍 Address"
                           FontWeight="SemiBold"/>

                <TextBox Margin="0,5,0,2"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Enter your address"/>

                <TextBlock Text="{Binding AddressError}"
                           Foreground="Red"
                           FontSize="10"
                           Margin="3,0,0,8"/>

                <!-- Password -->

                <TextBlock Text="🔒 Password"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="PasswordBox"
                             Margin="0,5,0,2"
                             Style="{StaticResource ModernPasswordBoxStyle}"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <TextBlock Text="{Binding PasswordError}"
                           Foreground="Red"
                           FontSize="10"
                           Margin="3,0,0,8"/>

                <!-- Confirm Password -->

                <TextBlock Text="🔒 Confirm Password"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="ConfirmPasswordBox"
                             Margin="0,5,0,2"
                             Style="{StaticResource ModernPasswordBoxStyle}"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                <TextBlock Text="{Binding ConfirmPasswordError}"
                           Foreground="Red"
                           FontSize="10"
                           Margin="3,0,0,20"/>

                <!-- Register Button -->

                <Button Content="Register"
                        Style="{StaticResource RegisterButtonStyle}"
                        Command="{Binding RegisterCommand}"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>